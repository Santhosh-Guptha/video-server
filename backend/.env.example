# ==============================================================================
# Camera Video Platform Configuration Template (.env.example)
# ==============================================================================
# All configuration parameters are governed by pydantic-settings in config.py.
# Commented or omitted settings automatically fall back to class-defined defaults.
# Use this file to fine-tune production nodes.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. CORE SYSTEM PARAMETERS
# ──────────────────────────────────────────────────────────────────────────────

# APP_NAME
# Description: Identifier for this instance. Used in logs and cache keys.
# Best Practice: Use lowercase, hyphenated strings.
# Default: camera-video-platform
APP_NAME=camera-video-platform

# DATABASE_URL
# Description: SQLAlchemy connection URI.
# Scenarios:
#   - LOCAL/DEV: Use SQLite ("sqlite+aiosqlite:///./data/app.db"). High speed, zero setup.
#   - PRODUCTION: Use PostgreSQL ("postgresql+asyncpg://vms_admin:vms_secure_password@localhost:5432/vms_db")
#     to support concurrent database writes from multiple camera loops and indexing hooks.
# Default: postgresql+asyncpg://vms_admin:vms_secure_password@localhost:5432/vms_db
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# REDIS_URL
# Description: Redis instance address for real-time viewer tracking, locking, and websocket state sync.
# Scenarios:
#   - Keep on localhost (127.0.0.1) for minimal network latency (<1ms is critical for RTCPeerConnection stats tracking).
# Default: redis://127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0


# ──────────────────────────────────────────────────────────────────────────────
# 2. UPSTREAM CAMERA CONFIGURATION REGISTRY
# ──────────────────────────────────────────────────────────────────────────────

# UPSTREAM_CAMERA_API_URL
# Description: Endpoint URL where the backend fetches camera configuration registries.
# Scenarios:
#   - Set to your central supervisor portal's camera sync API.
#   - Example: https://iportal2.sronprem.scanalitix.com/api/cameras/camera-videoserver?vsName=STVS1
# Default: "" (Empty means synchronization is bypassed or runs off cache fallback)
UPSTREAM_CAMERA_API_URL=https://iportal2.sronprem.scanalitix.com/api/cameras/camera-videoserver?vsName=STVS1

# UPSTREAM_TIMEOUT_SECONDS
# Description: Maximum time in seconds to wait for a response from the Upstream API.
# Scenarios:
#   - Keep at 10.0 for stable local networks.
#   - Increase to 20.0-30.0 for remote cells or high-latency WAN links.
# Default: 10.0
UPSTREAM_TIMEOUT_SECONDS=10.0

# UPSTREAM_SYNC_INTERVAL_MINUTES
# Description: How often (in minutes) to pull camera configurations from the Upstream API.
# Scenarios:
#   - 1-2 minutes: Fast propagation of camera edits/additions. Increases upstream API load.
#   - 5 minutes (Recommended): Good balance between sync delay and database/network overhead.
#   - 15+ minutes: High-scale environments with static, unchanging camera setups.
# Default: 5
UPSTREAM_SYNC_INTERVAL_MINUTES=5


# ──────────────────────────────────────────────────────────────────────────────
# 3. MEDIAMTX PROXY & SIGNALING ENGINE
# ──────────────────────────────────────────────────────────────────────────────

# MEDIAMTX_API_URL
# Description: Local URL for the MediaMTX REST API used by the backend to dynamically add/remove RTSP paths.
# Best Practice: Keep on localhost to protect MediaMTX config routes.
# Default: http://127.0.0.1:9997
MEDIAMTX_API_URL=http://127.0.0.1:9997

# MEDIAMTX_WEBRTC_URL
# Description: Local URL for the MediaMTX WebRTC signaling endpoint (WHEP/WHIP).
# Best Practice: Keep on localhost.
# Default: http://127.0.0.1:8889
MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889

# STUN_SERVERS
# Description: STUN (Session Traversal Utilities for NAT) server addresses in JSON array format.
# Scenarios:
#   - Use public stun servers (e.g. google stun) to resolve public NAT candidates for browser clients.
# Default: ["stun:stun.l.google.com:19302"]
STUN_SERVERS=["stun:stun.l.google.com:19302"]

# TURN_SERVER_URL
# Description: TURN (Traversal Using Relays around NAT) server URL to relay media packet streams.
# Scenarios:
#   - LOCAL: Not required if streaming locally.
#   - PRODUCTION: MUST configure a dedicated TURN server (e.g. Coturn listening on 3478) to allow
#     traffic through firewalls when direct peer-to-peer UDP/TCP routes fail.
# Default: turn:localhost:3478
TURN_SERVER_URL=turn:localhost:3478

# TURN_SERVER_USERNAME
# Description: Auth username for the Coturn TURN server.
# Default: vms_user
TURN_SERVER_USERNAME=admin

# TURN_SERVER_CREDENTIAL
# Description: Auth password for the Coturn TURN server.
# Default: vms_turn_password
TURN_SERVER_CREDENTIAL=admin123

# MEDIAMTX_PATCH_ONLY
# Description: Enforce patching of path configurations instead of deleting/re-adding them in MediaMTX.
# Scenarios:
#   - True (Recommended): Zero downtime when updating parameters. Highly recommended for production.
#   - False: Re-instantiates paths entirely. Causes minor streaming pauses.
# Default: true
MEDIAMTX_PATCH_ONLY=true

# ALLOW_DELETE_ADD_RECONFIGURATION
# Description: Safety fallback to allow deleting and re-creating a MediaMTX path if a configuration PATCH fails.
# Scenarios:
#   - False (Recommended): Protects active viewers from unintended disconnects.
#   - True: Resilient configuration recovery. Use in test environments.
# Default: false
ALLOW_DELETE_ADD_RECONFIGURATION=false


# ──────────────────────────────────────────────────────────────────────────────
# 4. PATHS AND FILE SYSTEM DIRECTORIES
# ──────────────────────────────────────────────────────────────────────────────

# FFMPEG_PATH
# Description: Absolute path to the FFmpeg executable or alias name.
# Scenarios:
#   - "ffmpeg" (Default): Resolves from system environment PATH variables.
#   - "/usr/bin/ffmpeg": Hardcoded linux binary path (recommended for daemon services like systemd).
# Default: ffmpeg
FFMPEG_PATH=ffmpeg

# RECORDING_DIR
# Description: Base directory where MediaMTX writes fMP4 segments.
# Scenarios:
#   - LOCAL/DEV: Keep relative path "./data/recordings" or "data/recordings".
#   - PRODUCTION: Mount a dedicated fast disk (SSD/NVMe or high-capacity NAS) and use absolute path.
# Default: ./data/recordings
RECORDING_DIR=./data/recordings

# HLS_DIR
# Description: Directory where MediaMTX generates on-demand HLS fallback files.
# Default: ./data/hls
HLS_DIR=./data/hls

# SEGMENT_TIME_SECONDS
# Description: Duration of each recorded fMP4 segment on disk.
# Scenarios:
#   - 60 seconds (Recommended): Optimal segment size for quick file-seeking and HLS index updates.
#   - 10-30 seconds: Lower latency seeking, but creates massive file directories and indexes.
#   - 300+ seconds: Minimizes database rows, but playback seeking takes longer to buffer.
# Default: 60
SEGMENT_TIME_SECONDS=60


# ──────────────────────────────────────────────────────────────────────────────
# 5. LIVE EGRESS SESSION LIMITS
# ──────────────────────────────────────────────────────────────────────────────

# MAX_SUBSCRIBERS_PER_STREAM
# Description: Safety limit to prevent resource exhaustion when a stream is over-subscribed.
# Scenarios:
#   - Adjust based on network egress capacity (e.g. 100 viewers * 1Mbps = 100Mbps egress bandwidth).
# Default: 200
MAX_SUBSCRIBERS_PER_STREAM=200

# MAX_WEBRTC_SESSIONS_PER_CAMERA
# Description: Hard viewer threshold specifically for WebRTC play sessions.
# Default: 100
MAX_WEBRTC_SESSIONS_PER_CAMERA=100

# ENABLE_WEBRTC
# Description: Master switch to enable/disable WebRTC live play features.
# Default: true
ENABLE_WEBRTC=true

# ENABLE_HLS_FALLBACK
# Description: Switch to enable/disable the Hls.js fallback play mechanism when WebRTC fails.
# Default: true
ENABLE_HLS_FALLBACK=true

# WEBRTC_CONNECTION_TIMEOUT_SECONDS
# Description: Seconds the player waits for a WebRTC peer connection before triggering the HLS fallback.
# Scenarios:
#   - 5 seconds: Fast failover. Highly recommended for high-speed local networks.
#   - 10 seconds (Recommended): Safe buffer to allow TURN server routing handshakes.
#   - 15+ seconds: High-latency WAN/Mobile clients.
# Default: 10
WEBRTC_CONNECTION_TIMEOUT_SECONDS=10


# ──────────────────────────────────────────────────────────────────────────────
# 6. WATCHDOG AND SCHEDULER INTERVALS
# ──────────────────────────────────────────────────────────────────────────────

# UI_POLL_SECONDS
# Description: How often (in seconds) the backend updates camera status caches and viewer metrics.
# Default: 5
UI_POLL_SECONDS=5

# SCHEDULER_INTERVAL_SECONDS
# Description: How often (in seconds) the main background scheduler runs to audit stream states.
# Default: 10
SCHEDULER_INTERVAL_SECONDS=10

# RECOVERY_INTERVAL_SECONDS
# Description: How often (in seconds) the gap recovery watchdog loops.
# Default: 300
RECOVERY_INTERVAL_SECONDS=300

# CLEANUP_INTERVAL_SECONDS
# Description: How often (in seconds) the storage retention engine cleans old files.
# Default: 600
CLEANUP_INTERVAL_SECONDS=600

# INDEXER_INTERVAL_SECONDS
# Description: How often (in seconds) the safety-net filesystem indexer reconciles files on disk.
# Scenarios:
#   - 600 (10 minutes - Recommended): Detects manual/mistaken file deletions quickly and prunes them.
#   - 3600-43200 (1-12 hours): Low-scale environments where database reads/writes should be minimized.
# Default: 600
INDEXER_INTERVAL_SECONDS=600


# ──────────────────────────────────────────────────────────────────────────────
# 7. EDGE PUSH & AUTO-MODE CONFIGURATIONS
# ──────────────────────────────────────────────────────────────────────────────

# EDGE_RECEIVER_HOST
# Description: Host IP where the custom TCP receiver listens.
# Default: 0.0.0.0
EDGE_RECEIVER_HOST=0.0.0.0

# EDGE_RECEIVER_PORT
# Description: Port where the custom TCP receiver listens.
# Default: 9999
EDGE_RECEIVER_PORT=9999

# EDGE_RECEIVER_ENABLED
# Description: Enable/disable the custom TCP receiver.
# Default: true
EDGE_RECEIVER_ENABLED=true

# ALLOW_UNKNOWN_EDGE_DEVICES
# Description: Auto-register edge devices even if they are not pre-configured in the database.
# Scenarios:
#   - False (Recommended): Strict authentication match. Protects system registry.
#   - True: Fast developer prototyping.
# Default: false
ALLOW_UNKNOWN_EDGE_DEVICES=false

# STRICT_CAMERA_VALIDATION
# Description: Verify that cameras are active and synced from the upstream API before pulling.
# Default: true
STRICT_CAMERA_VALIDATION=true

# ENABLE_EDGE_PUSH
# Description: Master switch for incoming edge push streams.
# Default: true
ENABLE_EDGE_PUSH=true

# EDGE_PUSH_PRIORITY
# Description: If in AUTO mode, prioritize Edge Push over RTSP Pull.
# Default: true
EDGE_PUSH_PRIORITY=true

# EDGE_PUSH_HEARTBEAT_TIMEOUT_SECONDS
# Description: Idle timeout (in seconds) before an edge push stream is declared dead.
# Default: 120
EDGE_PUSH_HEARTBEAT_TIMEOUT_SECONDS=120

# EDGE_PUSH_CHECK_INTERVAL_SECONDS
# Description: Watchdog interval (in seconds) to check edge push timeouts.
# Default: 30
EDGE_PUSH_CHECK_INTERVAL_SECONDS=30


# ──────────────────────────────────────────────────────────────────────────────
# 8. HEALTH AND TELEMETRY WATCHDOGS
# ──────────────────────────────────────────────────────────────────────────────

# ENABLE_RTSP_HEALTH_CHECK
# Description: Enable/disable the TCP ping health check for cameras.
# Default: true
ENABLE_RTSP_HEALTH_CHECK=true

# CAMERA_PING_INTERVAL_SECONDS
# Description: Interval (in seconds) between camera connection ping tests.
# Default: 120
CAMERA_PING_INTERVAL_SECONDS=120

# CAMERA_PING_TIMEOUT_SECONDS
# Description: Connection timeout (in seconds) for camera health checks.
# Default: 5
CAMERA_PING_TIMEOUT_SECONDS=5

# CAMERA_PING_MAX_CONCURRENT
# Description: Maximum concurrent health check threads to avoid overloading the server.
# Default: 10
CAMERA_PING_MAX_CONCURRENT=10


# ──────────────────────────────────────────────────────────────────────────────
# 9. H.265 ON-DEMAND TRANSCODER (HEVC COMPATIBILITY LAYER)
# ──────────────────────────────────────────────────────────────────────────────

# ENABLE_H265_TRANSCODING
# Description: Master switch to enable H.265 on-demand transcoding.
# Default: true
ENABLE_H265_TRANSCODING=true

# MAX_ACTIVE_TRANSCODERS
# Description: Maximum concurrent transcoding processes (FFmpeg) allowed on the server.
# Scenarios:
#   - Adjust based on CPU cores: 1 libx264 transcoder utilizes ~0.5 cores.
#   - For 8-core CPU, set to 10-12 max.
# Default: 10
MAX_ACTIVE_TRANSCODERS=10

# TRANSCODER_VCODEC
# Description: Codec used to encode the transcoded video.
# Scenarios:
#   - "libx264" (Default): High CPU utilization, universal compatibility.
#   - "h264_nvenc": NVIDIA hardware-accelerated GPU encoder. Negligible CPU impact.
#   - "h264_qsv": Intel QuickSync hardware-accelerated encoder.
# Default: libx264
TRANSCODER_VCODEC=libx264

# TRANSCODER_PRESET
# Description: Preset compression ratio vs encoding speed.
# Scenarios:
#   - "ultrafast" (Recommended): Lowest latency, slightly lower compression.
#   - "superfast" / "veryfast": Better quality, slightly higher CPU load.
# Default: ultrafast
TRANSCODER_PRESET=ultrafast

# TRANSCODER_TUNE
# Description: Zero latency tuning configuration for real-time monitoring.
# Default: zerolatency
TRANSCODER_TUNE=zerolatency

# TRANSCODER_GRACE_PERIOD_SECONDS
# Description: Time (in seconds) the backend keeps a transcoder running after the last viewer disconnects.
# Scenarios:
#   - 60 seconds (Recommended): Prevents constant FFmpeg restarts when users toggle cameras in a grid.
# Default: 60
TRANSCODER_GRACE_PERIOD_SECONDS=60


# ──────────────────────────────────────────────────────────────────────────────
# 10. STORAGE AND ARCHIVING POLICY
# ──────────────────────────────────────────────────────────────────────────────

# ENABLE_RECORDING
# Description: Enable/disable direct writing of streams to disk.
# Default: true
ENABLE_RECORDING=true

# RECORD_HD_ONLY
# Description: Save only MAIN/HD streams to disk.
# Scenarios:
#   - True (Recommended): Saves ~50% storage by skipping sub-streams.
#   - False: Uses RECORD_NORMAL and RECORD_MOBILE variables to save sub-streams.
# Default: true
RECORD_HD_ONLY=true

# RECORD_NORMAL
# Description: Record NORMAL/SUB streams. Ignored if RECORD_HD_ONLY is true.
# Default: false
RECORD_NORMAL=false

# RECORD_MOBILE
# Description: Record MOBILE streams. Ignored if RECORD_HD_ONLY is true.
# Default: false
RECORD_MOBILE=false


# ──────────────────────────────────────────────────────────────────────────────
# 11. STREAM SELECTION POLICY
# ──────────────────────────────────────────────────────────────────────────────

# LIVE_STREAM_PROFILE
# Description: Default profile used for live streams when adaptive mode is disabled.
# Options: HD | NORMAL | MOBILE
# Default: NORMAL
LIVE_STREAM_PROFILE=NORMAL

# ENABLE_ADAPTIVE_PROFILE
# Description: Dynamically switch live stream profiles based on the UI grid layout.
# Scenarios:
#   - True (Recommended): Uses HD when focused (1x1), drops to NORMAL for grids (2x2/3x3) to save bandwidth.
# Default: true
ENABLE_ADAPTIVE_PROFILE=true

# FOCUS_VIEW_PROFILE
# Description: Live stream profile used for 1x1 focused view.
# Default: HD
FOCUS_VIEW_PROFILE=HD

# GRID_VIEW_PROFILE
# Description: Live stream profile used for grid views (2x2/3x3).
# Default: NORMAL
GRID_VIEW_PROFILE=NORMAL

# MOBILE_VIEW_PROFILE
# Description: Live stream profile used on mobile/low-bandwidth clients.
# Default: MOBILE
MOBILE_VIEW_PROFILE=MOBILE


# ──────────────────────────────────────────────────────────────────────────────
# 12. PLAYBACK & STORAGE RETENTION POLICY
# ──────────────────────────────────────────────────────────────────────────────

# PLAYBACK_PROFILE
# Description: Default profile requested for recorded video playback.
# Default: HD
PLAYBACK_PROFILE=HD

# PLAYBACK_ALLOW_NORMAL_FALLBACK
# Description: Allow fallback to SUB/NORMAL recordings if HD/MAIN is missing.
# Default: true
PLAYBACK_ALLOW_NORMAL_FALLBACK=true

# PLAYBACK_ALLOW_MOBILE_FALLBACK
# Description: Allow fallback to MOBILE recordings if HD/NORMAL is missing.
# Default: false
PLAYBACK_ALLOW_MOBILE_FALLBACK=false

# PLAYBACK_SPEEDS
# Description: Supported video playback speeds in JSON array format.
# Default: [0.5, 1.0, 2.0, 4.0, 8.0]
PLAYBACK_SPEEDS=[0.5, 1.0, 2.0, 4.0, 8.0]

# ENABLE_RETENTION
# Description: Enable/disable the background archive cleanup loop.
# Default: true
ENABLE_RETENTION=true

# DEFAULT_RETENTION_DAYS
# Description: How many days of recorded segments to retain. Files older than this are deleted.
# Default: 30
DEFAULT_RETENTION_DAYS=30

# ENABLE_LOW_DISK_EVICTION
# Description: Evict the most outdated recordings when free storage falls below threshold to prevent VM disk full crashes.
# Default: true
ENABLE_LOW_DISK_EVICTION=true

# LOW_DISK_SPACE_THRESHOLD_GB
# Description: Free disk space threshold in GB below which emergency eviction is triggered.
# Default: 5.0
LOW_DISK_SPACE_THRESHOLD_GB=5.0

# TARGET_FREE_SPACE_GB
# Description: Free disk space in GB to target after emergency eviction completes.
# Default: 10.0
TARGET_FREE_SPACE_GB=10.0


# ──────────────────────────────────────────────────────────────────────────────
# 13. PLAYBACK TIMELINE POLICY
# ──────────────────────────────────────────────────────────────────────────────

# TIMELINE_CACHE_SECONDS
# Description: Seconds to cache timeline calculations in Redis.
# Default: 60
TIMELINE_CACHE_SECONDS=60

# TIMELINE_MERGE_THRESHOLD_SECONDS
# Description: Merge adjacent recording segments into a single timeline block if they are within this gap.
# Default: 5
TIMELINE_MERGE_THRESHOLD_SECONDS=5

# TIMELINE_DEFAULT_ZOOM
# Description: Default daily timeline view zoom.
# Default: 24h
TIMELINE_DEFAULT_ZOOM=24h

# ──────────────────────────────────────────────────────────────────────────────
# 14. DEVICE CONFIGURATION & LOCAL TRANSCODE TOGGLES
# ──────────────────────────────────────────────────────────────────────────────

# ENABLE_DEVICE_CONFIG
# Description: Enable/disable direct remote device configuration via ONVIF.
# Default: false
ENABLE_DEVICE_CONFIG=false

# ENABLE_LOCAL_TRANSCODE
# Description: Enable/disable local device transcoding.
# Default: false
ENABLE_LOCAL_TRANSCODE=false


# ──────────────────────────────────────────────────────────────────────────────
# 15. SD CARD ON-DEMAND RETRIEVAL POLICY
# ──────────────────────────────────────────────────────────────────────────────

# ENABLE_SD_CARD_ON_DEMAND
# Description: Enable/disable downloading missing recordings on-demand from the camera's local SD card storage.
# Default: true
ENABLE_SD_CARD_ON_DEMAND=true

# SD_CARD_ON_DEMAND_RETENTION_SECONDS
# Description: Duration (in seconds) to cache downloaded SD card segments on the server before pruning.
# Default: 3600
SD_CARD_ON_DEMAND_RETENTION_SECONDS=3600

