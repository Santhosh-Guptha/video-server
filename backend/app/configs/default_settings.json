    "enable_adaptive_profile": true,
    "focus_view_profile": "HD",
    "grid_view_profile": "NORMAL",
    "mobile_view_profile": "MOBILE",
    "playback_profile": "HD",
    "playback_allow_normal_fallback": true,
    "playback_allow_mobile_fallback": false,
    "playback_speeds": [
        0.5,
        1.0,
        2.0,
        4.0,
        8.0
