{
    "app_name": "camera-video-platform",
    "enable_webrtc": true,
    "database_url": "postgresql+asyncpg://vms_admin:vms_secure_password@localhost:5432/vms_db",
    "redis_url": "redis://127.0.0.1:6379/0",
    "mediamtx_api_url": "http://127.0.0.1:9997",
